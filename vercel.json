{
  "installCommand": "npm install --prefix mobile",
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist-web",
  "functions": {
    "api/brokers/connect.js": { "maxDuration": 60 },
    "api/brokers/health.js": { "maxDuration": 15 },
    "api/brokers/account.js": { "maxDuration": 30 },
    "api/brokers/order.js": { "maxDuration": 30 },
    "api/brokers/symbols.js": { "maxDuration": 30 },
    "api/scan/index.js": { "maxDuration": 60 },
    "api/scan/status.js": { "maxDuration": 15 },
    "api/scan/auto.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/download/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"lumo-edge-pro.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/download/index.html" },
    { "source": "/download/", "destination": "/download/index.html" },
    { "source": "/portal", "destination": "/portal/index.html" },
    { "source": "/portal/", "destination": "/portal/index.html" },
    { "source": "/portal/dashboard", "destination": "/portal/dashboard/index.html" },
    { "source": "/portal/dashboard/", "destination": "/portal/dashboard/index.html" },
    { "source": "/portal/pending", "destination": "/portal/pending/index.html" },
    { "source": "/portal/pending/", "destination": "/portal/pending/index.html" },
    {
      "source": "/((?!api/|download/|_expo/|assets/|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
